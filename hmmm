function UILibrary:Notify(Title, Description, Duration, Icon, TextColor, DurationColor)
	local DescriptionColor
	local HasCustomTextColor = typeof(TextColor) == "Color3"
	if typeof(Title) == "table" then
		local Args = Title
		Title = Args.Title or Args.Name or "Notification"
		Description = Args.Description or Args.Content or Args.Text or ""
		Duration = Args.Duration or Args.Time
		Icon = Args.Icon or Args.Image
		TextColor = Args.TextColor or Args.Color
		DescriptionColor = Args.DescriptionColor
		DurationColor = Args.DurationColor or Args.LineColor or Args.TimerColor
		HasCustomTextColor = typeof(TextColor) == "Color3"
	end

	Title = tostring(Title or "Notification")
	Description = tostring(Description or "")
	Duration = math.max(tonumber(Duration) or 4, 0.1)
	TextColor = typeof(TextColor) == "Color3" and TextColor or Color3fromRGB(235, 235, 235)
	DescriptionColor = typeof(DescriptionColor) == "Color3" and DescriptionColor or (HasCustomTextColor and TextColor or Color3fromRGB(165, 165, 165))
	DurationColor = typeof(DurationColor) == "Color3" and DurationColor or self.ColorTheme

	local IconImage = ""
	if Icon ~= nil and Icon ~= "" then
		IconImage = tostring(Icon)
		if not Sfind(IconImage, "://", 1, true) then
			IconImage = "rbxassetid://" .. IconImage
		end
	end

	local HasIcon = IconImage ~= ""
	local Notification = Instancenew("Frame")
	Notification.Name = "Notification"
	Notification.BackgroundColor3 = Color3fromRGB(18, 18, 18)
	Notification.BackgroundTransparency = 1
	Notification.BorderSizePixel = 0
	Notification.Size = UDim2new(1, 0, 0, 58)
	Notification.ZIndex = 100

	local function CreateDurationLine(Name, Position, AnchorPoint)
		local Line = Instancenew("Frame")
		Line.Name = Name
		Line.AnchorPoint = AnchorPoint
		Line.BackgroundColor3 = DurationColor
		Line.BackgroundTransparency = 1
		Line.BorderSizePixel = 0
		Line.Position = Position
		Line.ZIndex = 102
		Line.Parent = Notification
		return Line
	end

	local TopLine = CreateDurationLine("DurationTop", UDim2new(), Vector2new())
	TopLine.Size = UDim2new(0, 0, 0, 3)
	local RightLine = CreateDurationLine("DurationRight", UDim2new(1, -3, 0, 0), Vector2new())
	RightLine.Size = UDim2new(0, 3, 0, 0)
	local BottomLine = CreateDurationLine("DurationBottom", UDim2new(1, 0, 1, -3), Vector2new(1, 0))
	BottomLine.Size = UDim2new(0, 0, 0, 3)
	local LeftLine = CreateDurationLine("DurationLeft", UDim2new(0, 0, 1, 0), Vector2new(0, 1))
	LeftLine.Size = UDim2new(0, 3, 0, 0)
	local DurationLines = { TopLine, RightLine, BottomLine, LeftLine }

	local NotificationIcon = Instancenew("ImageLabel")
	NotificationIcon.Name = "Icon"
	NotificationIcon.BackgroundTransparency = 1
	NotificationIcon.Image = IconImage
	NotificationIcon.ImageColor3 = TextColor
	NotificationIcon.ImageTransparency = 1
	NotificationIcon.Position = UDim2new(0, 18, 0, 16)
	NotificationIcon.ScaleType = Enum.ScaleType.Fit
	NotificationIcon.Size = UDim2new(0, 26, 0, 26)
	NotificationIcon.Visible = HasIcon
	NotificationIcon.ZIndex = 101
	NotificationIcon.Parent = Notification

	local TextPosition = HasIcon and UDim2new(0, 56, 0, 8) or UDim2new(0, 18, 0, 8)
	local TextWidth = HasIcon and -70 or -30
	local NotificationTitle = Instancenew("TextLabel")
	NotificationTitle.Name = "Title"
	NotificationTitle.BackgroundTransparency = 1
	NotificationTitle.Position = TextPosition
	NotificationTitle.Size = UDim2new(1, TextWidth, 0, 17)
	NotificationTitle.Font = Enum.Font.GothamMedium
	NotificationTitle.Text = Title
	NotificationTitle.TextColor3 = TextColor
	NotificationTitle.TextSize = 13
	NotificationTitle.TextTransparency = 1
	NotificationTitle.TextTruncate = Enum.TextTruncate.AtEnd
	NotificationTitle.TextXAlignment = Enum.TextXAlignment.Left
	NotificationTitle.ZIndex = 101
	NotificationTitle.Parent = Notification

	local NotificationDescription = Instancenew("TextLabel")
	NotificationDescription.Name = "Description"
	NotificationDescription.BackgroundTransparency = 1
	NotificationDescription.Position = UDim2new(TextPosition.X.Scale, TextPosition.X.Offset, 0, 27)
	NotificationDescription.Size = UDim2new(1, TextWidth, 0, 16)
	NotificationDescription.Font = Enum.Font.Gotham
	NotificationDescription.Text = Description
	NotificationDescription.TextColor3 = DescriptionColor
	NotificationDescription.TextSize = 11
	NotificationDescription.TextTransparency = 1
	NotificationDescription.TextTruncate = Enum.TextTruncate.AtEnd
	NotificationDescription.TextXAlignment = Enum.TextXAlignment.Left
	NotificationDescription.ZIndex = 101
	NotificationDescription.Parent = Notification

	Notification.Parent = self.NotificationHolder

	Utils.Tween(Notification, "Quad", "Out", .18, { BackgroundTransparency = 0 })
	Utils.Tween(NotificationTitle, "Quad", "Out", .18, { TextTransparency = 0 })
	Utils.Tween(NotificationDescription, "Quad", "Out", .18, { TextTransparency = 0 })
	if HasIcon then
		Utils.Tween(NotificationIcon, "Quad", "Out", .18, { ImageTransparency = 0 })
	end

	local Perimeter = (280 * 2) + (58 * 2)
	task.spawn(function()
		local TopTween = Utils.Tween(TopLine, "Linear", "Out", Duration * (280 / Perimeter), { Size = UDim2new(1, 0, 0, 3), BackgroundTransparency = 0 })
		CWait(TopTween.Completed)
		local RightTween = Utils.Tween(RightLine, "Linear", "Out", Duration * (58 / Perimeter), { Size = UDim2new(0, 3, 1, 0), BackgroundTransparency = 0 })
		CWait(RightTween.Completed)
		local BottomTween = Utils.Tween(BottomLine, "Linear", "Out", Duration * (280 / Perimeter), { Size = UDim2new(1, 0, 0, 3), BackgroundTransparency = 0 })
		CWait(BottomTween.Completed)
		Utils.Tween(LeftLine, "Linear", "Out", Duration * (58 / Perimeter), { Size = UDim2new(0, 3, 1, 0), BackgroundTransparency = 0 })
	end)

	task.delay(Duration, function()
		if Notification.Parent == nil then
