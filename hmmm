				local Label = Instancenew("TextLabel")
				Label.Name = "Label"
				Label.BackgroundTransparency = 1
				Label.Size = UDim2new(1, 0, 0, 24)
				Label.Font = Enum.Font.Gotham
				Label.TextSize = 13
				Label.TextColor3 = Colors.PageTextIdle
				Label.TextXAlignment = Enum.TextXAlignment.Left
				Label.TextWrapped = true
				Label.Text = Text
				Label.ZIndex = BaseZIndex
				Label.Parent = Section.Options

				return {
					Set = function(NewText)
						Label.Text = NewText
					end
				}
			end



			function ElementLibrary.KeyValue(Key, Value)
				local Container = Instancenew("Frame")
				Container.Name = "KeyValue"
				Container.Size = UDim2new(1, 0, 0, 24)
				Container.BackgroundTransparency = 1
				Container.ZIndex = BaseZIndex

				local KeyLabel = Instancenew("TextLabel")
				KeyLabel.Name = "Key"
				KeyLabel.BackgroundTransparency = 1
				KeyLabel.Size = UDim2new(0.45, -8, 1, 0)
				KeyLabel.Font = Enum.Font.Gotham
				KeyLabel.TextSize = 13
				KeyLabel.TextColor3 = Colors.PageTextIdle
				KeyLabel.TextTruncate = Enum.TextTruncate.AtEnd
				KeyLabel.TextXAlignment = Enum.TextXAlignment.Left
				KeyLabel.Text = Key
				KeyLabel.ZIndex = BaseZIndex + 1
				KeyLabel.Parent = Container

				local ValueLabel = Instancenew("TextLabel")
				ValueLabel.Name = "Value"
				ValueLabel.BackgroundTransparency = 1
				ValueLabel.Position = UDim2new(0.45, 8, 0, 0)
				ValueLabel.Size = UDim2new(0.55, -8, 1, 0)
				ValueLabel.Font = Enum.Font.GothamMedium
				ValueLabel.TextSize = 13
				ValueLabel.TextColor3 = self.ColorTheme
				ValueLabel.TextTruncate = Enum.TextTruncate.AtEnd
				ValueLabel.TextXAlignment = Enum.TextXAlignment.Left
				ValueLabel.Text = tostring(Value)
				ValueLabel.ZIndex = BaseZIndex + 1
				ValueLabel.Parent = Container

				local function UpdateKeyValueLayout()
					local AvailableWidth = Container.AbsoluteSize.X
					if AvailableWidth <= 0 then
						return
					end

					local KeyWidth = math.min(KeyLabel.TextBounds.X, AvailableWidth * 0.45)
					KeyLabel.Size = UDim2.fromOffset(KeyWidth, 24)
					ValueLabel.Position = UDim2.fromOffset(KeyWidth + 12, 0)
					ValueLabel.Size = UDim2.fromOffset(math.max(AvailableWidth - KeyWidth - 12, 0), 24)
				end

				Container.Parent = Section.Options
				AddConnection(CConnect(GetPropertyChangedSignal(Container, "AbsoluteSize"), UpdateKeyValueLayout))
				AddConnection(CConnect(GetPropertyChangedSignal(KeyLabel, "TextBounds"), UpdateKeyValueLayout))
				UpdateKeyValueLayout()

				return {
					Set = function(NewValue)
						ValueLabel.Text = tostring(NewValue)
					end
				}
			end

			function ElementLibrary.Divider()
				local Line = Instancenew("Frame")
				Line.Name = "Divider"
				Line.Size = UDim2new(1, 0, 0, 1)
				Line.BackgroundColor3 = Colors.PageBorderIdle
				Line.BorderSizePixel = 0
				Line.ZIndex = BaseZIndex
				Line.Parent = Section.Options
			end

			return ElementLibrary

		end

		return PageLibrary
	end

	return WindowLibrary
end

