		end
		if HasIcon then
			Utils.Tween(NotificationIcon, "Quad", "Out", .2, { ImageTransparency = 1 })
		end

		CWait(FadeOut.Completed)
		if Notification.Parent ~= nil then
			Destroy(Notification)
		end
	end)

	return Notification
end

