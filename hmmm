Utils.MultColor3 = function(Color, Delta)
	return Color3new(clamp(Color.R * Delta, 0, 1), clamp(Color.G * Delta, 0, 1), clamp(Color.B * Delta, 0, 1))
end

Utils.Draggable = function(UI, DragUi)
	local DragSpeed = 0
	local StartPos
	local DragToggle, DragInput, DragStart

	if not DragUi then
		DragUi = UI
	end

	local function UpdateInput(Input)
		local Delta = Input.Position - DragStart
		local Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + Delta.X, StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y);

		Utils.Tween(UI, "Linear", "Out", .25, {
			Position = Position
		});
	end
    local CoreGui = Services.CoreGui
    local UserInputService = Services.UserInputService

	AddConnection(CConnect(UI.InputBegan, function(Input)
		if ((Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch) and not UserInputService.GetFocusedTextBox(UserInputService)) then
			local Objects = CoreGui.GetGuiObjectsAtPosition(CoreGui, Input.Position.X, Input.Position.Y)
			for Index = 1, #Objects do
				if Objects[Index].Name == "ResizeHandle" or Objects[Index]:FindFirstAncestor("ResizeHandle") then
					return
				end
			end

			DragToggle = true
			DragStart = Input.Position
			StartPos = UI.Position

			AddConnection(CConnect(Input.Changed, function()
				if (Input.UserInputState == Enum.UserInputState.End) then
					DragToggle = false
				end
			end));
		end
	end));

	AddConnection(CConnect(UI.InputChanged, function(Input)
		if (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
			DragInput = Input
		end
	end));

	AddConnection(CConnect(UserInputService.InputChanged, function(Input)
		if (Input == DragInput and DragToggle) then
			UpdateInput(Input);
		end
	end));
end

Utils.Resizable = function(Window, Handle, MinimumSize, OnResize)
	local UserInputService = Services.UserInputService
	local Resizing = false
	local ResizeStart
	local StartSize

	local function UpdateSize(Input)
		local Delta = Input.Position - ResizeStart
		local Width = math.max(MinimumSize.X, StartSize.X + Delta.X)
		local Height = math.max(MinimumSize.Y, StartSize.Y + Delta.Y)
		local NewSize = UDim2.fromOffset(Width, Height)

		Window.Size = NewSize
		if OnResize then
			OnResize(NewSize)
		end
	end

	AddConnection(CConnect(Handle.InputBegan, function(Input)
		if (Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch) then
			Resizing = true
			ResizeStart = Input.Position
			StartSize = Window.AbsoluteSize
		end
	end))

	AddConnection(CConnect(UserInputService.InputChanged, function(Input)
		if Resizing and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
			UpdateSize(Input)
		end
	end))

	AddConnection(CConnect(UserInputService.InputEnded, function(Input)
		if Resizing and (Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch) then
			Resizing = false
		end
	end))
end

